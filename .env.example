# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Both come from Supabase → Project Settings → API keys. Never use the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Leave both empty and run `npm run dev` to work on made-up sample data kept in this browser.
# A production build without them shows a setup message instead, unless VITE_DEMO=true is set.
# VITE_DEMO=true
